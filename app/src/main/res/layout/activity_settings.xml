<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/plane"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/plane"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:navigationIcon="@drawable/ic_back"
        app:title="설정"
        app:titleTextColor="@color/ink_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="차량" />

            <TextView
                style="@style/LabelMuted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="배터리 총 용량 (kWh)" />

            <EditText
                android:id="@+id/in_capacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_field"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:textColor="@color/ink_primary" />

            <TextView
                style="@style/LabelMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="차량에서 용량을 직접 읽어오면 그 값이 우선합니다. 휴대폰에서는 이 값으로 계산합니다." />

            <TextView
                style="@style/CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="충전 요금" />

            <TextView
                style="@style/LabelMuted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="완속 단가 (원/kWh)" />

            <EditText
                android:id="@+id/in_rate_ac"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_field"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:textColor="@color/ink_primary" />

            <TextView
                style="@style/LabelMuted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="급속 단가 (원/kWh)" />

            <EditText
                android:id="@+id/in_rate_dc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_field"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:textColor="@color/ink_primary" />

            <TextView
                style="@style/LabelMuted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="급속으로 판정할 출력 기준 (kW)" />

            <EditText
                android:id="@+id/in_dc_kw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_field"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:textColor="@color/ink_primary" />

            <TextView
                style="@style/CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="기록" />

            <TextView
                style="@style/LabelMuted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이보다 짧은 주행은 저장하지 않음 (m)" />

            <EditText
                android:id="@+id/in_min_trip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_field"
                android:importantForAutofill="no"
                android:inputType="number"
                android:padding="12dp"
                android:textColor="@color/ink_primary" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_autostart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="시동/부팅 후 자동으로 기록 시작"
                android:textColor="@color/ink_primary" />

            <TextView
                style="@style/CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="NAS 서버 연동" />

            <TextView
                style="@style/LabelMuted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="서버 주소 (예: https://evlog.내도메인)" />

            <EditText
                android:id="@+id/in_server_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_field"
                android:hint="https://"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:padding="12dp"
                android:textColor="@color/ink_primary"
                android:textColorHint="@color/ink_muted" />

            <TextView
                style="@style/LabelMuted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="접속 토큰 (docker-compose.yml 의 EVLOG_TOKEN)" />

            <EditText
                android:id="@+id/in_server_token"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_field"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="@color/ink_primary" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_sync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="기록이 쌓이면 자동으로 서버에 올리기"
                android:textColor="@color/ink_primary" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_route"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="주행 경로(위치) 함께 기록"
                android:textColor="@color/ink_primary" />

            <TextView
                android:id="@+id/txt_sync_status"
                style="@style/LabelMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"
                android:text="" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sync"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="지금 서버로 올리기" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="설정 저장" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_export"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/menu_export" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"
                android:text="모든 기록 삭제"
                android:textColor="@color/status_critical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
