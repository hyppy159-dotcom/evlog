<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/plane"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- 배터리 + 데이터 출처 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/EvCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.jhkim.evlog.ui.BatteryGaugeView
                    android:id="@+id/gauge"
                    android:layout_width="150dp"
                    android:layout_height="150dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_range"
                        style="@style/ValueBig"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—" />

                    <TextView
                        style="@style/LabelMuted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="주행 가능 거리" />

                    <TextView
                        android:id="@+id/txt_source"
                        style="@style/LabelMuted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="데이터 출처: 대기 중" />

                    <TextView
                        android:id="@+id/txt_temp"
                        style="@style/LabelMuted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 기록 상태 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/EvCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_status"
                        style="@style/ValueBig"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="대기 중" />

                    <TextView
                        android:id="@+id/txt_status_sub"
                        style="@style/LabelMuted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="기록을 시작하면 주행과 충전이 자동으로 쌓입니다." />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:minWidth="112dp"
                    android:text="@string/start_logging" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_drive"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="56dp"
            android:text="주행 중 모니터 열기"
            android:textSize="16sp" />

        <!-- 요약 수치 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/EvCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="요약" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.jhkim.evlog.ui.StatTileView
                        android:id="@+id/stat_month_km"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <com.jhkim.evlog.ui.StatTileView
                        android:id="@+id/stat_month_cost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <com.jhkim.evlog.ui.StatTileView
                        android:id="@+id/stat_avg_eff"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <com.jhkim.evlog.ui.StatTileView
                        android:id="@+id/stat_total_km"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 전비 추이 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/EvCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="최근 주행 전비 (km/kWh)" />

                <com.jhkim.evlog.ui.TrendChartView
                    android:id="@+id/chart"
                    android:layout_width="match_parent"
                    android:layout_height="170dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/txt_hint"
            style="@style/LabelMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp"
            android:lineSpacingExtra="3dp"
            android:text="" />
    </LinearLayout>
</ScrollView>
