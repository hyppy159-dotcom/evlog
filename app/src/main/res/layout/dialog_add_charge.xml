<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="8dp"
        android:paddingEnd="22dp"
        android:paddingBottom="4dp">

        <TextView
            style="@style/LabelMuted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="충전량 (kWh)" />

        <EditText
            android:id="@+id/in_kwh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_field"
            android:hint="예: 42.5"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:textColor="@color/ink_primary"
            android:textColorHint="@color/ink_muted" />

        <TextView
            style="@style/LabelMuted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="충전 방식" />

        <RadioGroup
            android:id="@+id/group_kind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radio_ac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="완속 (AC)"
                android:textColor="@color/ink_primary" />

            <RadioButton
                android:id="@+id/radio_dc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:text="급속 (DC)"
                android:textColor="@color/ink_primary" />
        </RadioGroup>

        <TextView
            style="@style/LabelMuted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="요금 (원) — 비우면 단가로 자동 계산" />

        <EditText
            android:id="@+id/in_cost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_field"
            android:hint="자동 계산"
            android:importantForAutofill="no"
            android:inputType="number"
            android:padding="12dp"
            android:textColor="@color/ink_primary"
            android:textColorHint="@color/ink_muted" />

        <TextView
            style="@style/LabelMuted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="메모" />

        <EditText
            android:id="@+id/in_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_field"
            android:hint="예: 홈플러스 지하 급속"
            android:importantForAutofill="no"
            android:inputType="text"
            android:padding="12dp"
            android:textColor="@color/ink_primary"
            android:textColorHint="@color/ink_muted" />
    </LinearLayout>
</ScrollView>
